<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentCabinet.ViewModels"
             xmlns:conv="clr-namespace:StudentCabinet.Converters"
             x:Class="StudentCabinet.Views.StudentDetailPage"
             x:DataType="vm:StudentDetailViewModel"
             Title="Деталі студента">

    <!-- повернення виконується лише через GoBackCommand -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <conv:ScoreToColorConverter x:Key="ScoreToColor" Threshold="4.0" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="ПІБ" TextColor="Gray" />
        <Label AutomationId="DetailName" Text="{Binding FullName}" FontSize="20" FontAttributes="Bold" />

        <Label Text="Група" TextColor="Gray" />
        <Label AutomationId="DetailGroup" Text="{Binding Group}" FontSize="18" />

        <Label Text="Середній бал" TextColor="Gray" />
        <Label AutomationId="DetailScore"
               Text="{Binding AverageScore, StringFormat='{0:F1}'}"
               TextColor="{Binding AverageScore, Converter={StaticResource ScoreToColor}}"
               FontSize="28" FontAttributes="Bold" />

        <Label Text="Редагування середнього балу" FontAttributes="Bold" Margin="0,10,0,0" />
        <Stepper AutomationId="ScoreStepper"
                 Minimum="0" Maximum="5" Increment="0.1"
                 Value="{Binding AverageScore, Mode=TwoWay}" />

        <Label Text="Бал змінено — натисніть «Зберегти»"
               TextColor="#E65100"
               IsVisible="{Binding IsChanged}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
            <Button AutomationId="BackButton" Text="Назад"
                    Command="{Binding GoBackCommand}" />
            <Button Grid.Column="1" AutomationId="SaveButton" Text="Зберегти"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>
